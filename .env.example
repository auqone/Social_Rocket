# Social Rocket Environment Variables
# Copy this file to .env and fill in your credentials
# Environment variables are MORE SECURE than storing credentials in config.json

# AI API Keys (at least one required for content generation)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# X / Twitter
X_USERNAME=
X_PASSWORD=

# LinkedIn
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=

# Facebook
FACEBOOK_EMAIL=
FACEBOOK_PASSWORD=
FACEBOOK_URL=

# Threads
THREADS_USERNAME=
THREADS_PASSWORD=

# Reddit
REDDIT_USERNAME=
REDDIT_PASSWORD=

# Instagram
INSTAGRAM_USERNAME=
INSTAGRAM_PASSWORD=

# TikTok
TIKTOK_USERNAME=
TIKTOK_PASSWORD=

# Quora
QUORA_EMAIL=
QUORA_PASSWORD=

# Note: If you have 1Password CLI installed, Social Rocket can fetch credentials
# from your vault automatically, which is even more secure than .env files.
